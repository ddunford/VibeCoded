{
  "name": "code-explainer",
  "version": "1.0.0",
  "description": "A specialized tool for code analysis and documentation generation, powered by CodeLLaMA",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-client": "cd client && npm install",
    "setup": "npm install && npm run install-client"
  },
  "keywords": ["code analysis", "documentation", "code explanation", "AI", "CodeLLaMA"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
